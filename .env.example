# ══════════════════════════════════════════════════════════════════
# ARIA Trading Bot — Configuration
# Copiez ce fichier vers .env et remplissez TOUTES les valeurs.
# Ne commitez JAMAIS le fichier .env dans Git.
# ══════════════════════════════════════════════════════════════════

# ── MongoDB Atlas ─────────────────────────────────────────────────
# Créez un cluster gratuit sur https://cloud.mongodb.com
# Ajoutez votre IP dans "Network Access" ou utilisez 0.0.0.0/0 (dev seulement)
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=trading_bot

# ── Anthropic (Claude AI) ─────────────────────────────────────────
# Obtenez votre clé sur https://console.anthropic.com
# Format : sk-ant-api03-...
ANTHROPIC_API_KEY=sk-ant-VOTRE_CLE_ICI

# ── Binance ───────────────────────────────────────────────────────
# TESTNET (recommandé pour débuter) : https://testnet.binance.vision
# LIVE : https://www.binance.com/fr/my/settings/api-management
#
# SÉCURITÉ ABSOLUE : Désactivez les permissions de RETRAIT sur vos clés !
# Activez UNIQUEMENT : "Activer le trading Spot & Marge"
BINANCE_API_KEY=VOTRE_BINANCE_API_KEY
BINANCE_SECRET_KEY=VOTRE_BINANCE_SECRET_KEY
BINANCE_TESTNET=true

# ── Sécurité JWT ─────────────────────────────────────────────────
# Générez une clé sécurisée avec :
#   python -c "import secrets; print(secrets.token_hex(32))"
# Ne réutilisez JAMAIS cette clé ailleurs
SECRET_KEY=GENEREZ_UNE_CLE_ALEATOIRE_DE_64_CARACTERES
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Application ───────────────────────────────────────────────────
ENVIRONMENT=development
# En production : mettez votre vrai domaine
CORS_ORIGINS=http://localhost:5173

# ══════════════════════════════════════════════════════════════════
# CHECKLIST AVANT LE PREMIER DÉMARRAGE :
# [ ] MONGODB_URL configurée avec vos identifiants Atlas
# [ ] ANTHROPIC_API_KEY obtenue sur console.anthropic.com
# [ ] BINANCE_API_KEY et SECRET_KEY créées (testnet ou live)
# [ ] Permissions de RETRAIT désactivées sur Binance
# [ ] SECRET_KEY générée aléatoirement (minimum 32 chars)
# [ ] BINANCE_TESTNET=true pour les tests
# ══════════════════════════════════════════════════════════════════
